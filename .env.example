# 复制为 .env 并按需修改（docker-compose 会自动读取）
# 服务端口（PaaS 通常用 8080 或 3000）
PORT=8080
HOST=0.0.0.0

# 鉴权签名密钥：生产务必改成随机长字符串
AUTH_SECRET=change-me-in-prod

# 数据文件路径（容器里挂卷，例如 /data/db.json）
DATA_FILE=/data/db.json

# 初始管理员用户名（逗号分隔，默认 beau）。这些名字用 ADMIN_PASSWORD 登录即为管理员（免审批）
ADMIN_USERS=beau

# 登录密码（生产务必改成自己的强密码；不设置则用代码默认值）
# 成员：任意名字 + 成员密码，登录后为只读，需管理员审批才解锁编辑
MEMBER_PASSWORD=qbsh2026@
# 管理员：ADMIN_USERS 中的名字 + 管理员密码，登录即获全部权限（无需审批）
ADMIN_PASSWORD=3612047Beau
